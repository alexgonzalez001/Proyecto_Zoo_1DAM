<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.proyecto_zoo_1dam.controller.LoginController" 
    spacing="15"
    alignment="CENTER"
    style="-fx-padding: 60; -fx-background-color: #f0f0f0;">

    <Label text="🦁 Zoo Login" styleClass="title" />

    <TextField fx:id="usernameField" promptText="Usuario" maxWidth="200" />

    <PasswordField fx:id="passwordField" promptText="Contraseña" maxWidth="200" />

    <Button text="Entrar" onAction="#onLogin" maxWidth="200" />

    <Label fx:id="messageLabel" style="-fx-text-fill: red;" />

</VBox>